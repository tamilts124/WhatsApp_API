						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"phones\": [\"91995xxxxxxx\", \"91987xxxxxxx\"],\n    \"message\": \"Bulk hello!\",\n    \"delayMs\": 2000\n}"
