		{
			"name": "List Messages",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/messages/91995xxxxxxx?count=20",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"messages",
						"91995xxxxxxx"
					],
					"query": [
						{
							"key": "count",
							"value": "20"
						}
					]
				}
			},
			"response": []
		},
		{
			"name": "Send Message",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"phone\": \"91995xxxxxxx\",\n    \"message\": \"Hello from Node.js TypeScript API!\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/send",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"send"
					]
				}
			},
			"response": []
		},
		{
